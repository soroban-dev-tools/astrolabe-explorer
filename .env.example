# Optional. Point the app at a local or alternate deployment JSON file.
# When unset, the app uses the contract ids vendored in @astrolabe/sdk.
# See docs/multi-repo.md section 5.
# CONSTELLATION_DEPLOYMENTS=../astrolabe-contracts/deployments/local-testnet.json

# Optional. Override the Soroban RPC endpoint. Defaults to public Testnet RPC.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional. Point to an Astrolabe indexer instance for recent schema attestations.
# When unset, the app gracefully degrades to direct lookups on chain.
# NEXT_PUBLIC_INDEXER_URL=https://indexer.astrolabe.example
